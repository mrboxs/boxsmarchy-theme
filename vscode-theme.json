    "gitDecoration.modifiedResourceForeground": "#e5c07b",
    "gitDecoration.deletedResourceForeground": "#e06c75",
    "gitDecoration.untrackedResourceForeground": "#98c379",
    "gitDecoration.ignoredResourceForeground": "#828997",
    "gitDecoration.conflictingResourceForeground": "#e06c75",
    "terminal.background": "#09090b",
    "terminal.foreground": "#fafafa",
    "terminal.selectionBackground": "#212121",
    "terminal.ansiBlack": "#09090b",
    "terminal.ansiRed": "#e06c75",
    "terminal.ansiGreen": "#98c379",
    "terminal.ansiYellow": "#e5c07b",
    "terminal.ansiBlue": "#61afef",
    "terminal.ansiMagenta": "#c678dd",
    "terminal.ansiCyan": "#56b6c2",
    "terminal.ansiWhite": "#fafafa",
    "terminal.ansiBrightBlack": "#828997",
    "terminal.ansiBrightRed": "#e06c75",
    "terminal.ansiBrightGreen": "#98c379",
    "terminal.ansiBrightYellow": "#e5c07b",
    "terminal.ansiBrightBlue": "#61afef",
    "terminal.ansiBrightMagenta": "#c678dd",
    "terminal.ansiBrightCyan": "#56b6c2",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "semanticTokenColors": {
    "variable": "#e06c75",
    "variable.readonly": "#d19a66",
    "variable.defaultLibrary": "#e5c07b",
    "parameter": "#e06c75",
    "property": "#e06c75",
    "property.readonly": "#d19a66",
    "function": "#61afef",
    "function.defaultLibrary": "#56b6c2",
    "method": "#61afef",
    "class": "#e5c07b",
    "interface": "#e5c07b",
    "enum": "#e5c07b",
    "enumMember": "#d19a66",
    "type": "#e5c07b",
    "typeParameter": "#e5c07b",
    "struct": "#e5c07b",
    "namespace": "#e5c07b",
    "macro": "#c678dd",
    "decorator": "#d19a66",
    "string": "#98c379",
    "number": "#d19a66",
    "boolean": "#d19a66",
    "regexp": "#56b6c2",
    "operator": "#c678dd",
    "keyword": "#c678dd",
    "comment": { "foreground": "#828997", "italic": true }
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#828997", "fontStyle": "italic" } },
    { "scope": ["variable", "entity.name.tag", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#e06c75" } },
    { "scope": ["entity.name.function", "support.function", "variable.function", "entity.name.section"], "settings": { "foreground": "#61afef" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.class", "support.type", "entity.name.namespace"], "settings": { "foreground": "#e5c07b" } },
    { "scope": ["keyword", "storage", "storage.type", "keyword.operator"], "settings": { "foreground": "#c678dd" } },
    { "scope": ["string", "markup.inline.raw", "markup.fenced_code.block"], "settings": { "foreground": "#98c379" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "entity.other.attribute-name"], "settings": { "foreground": "#d19a66" } },
    { "scope": ["support.constant", "support.variable", "constant.character.escape", "string.regexp", "keyword.other.unit"], "settings": { "foreground": "#56b6c2" } },
    { "scope": ["punctuation", "meta.brace", "punctuation.definition.tag"], "settings": { "foreground": "#abb2bf" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#e06c75", "fontStyle": "underline" } },
    { "scope": ["invalid.deprecated"], "settings": { "foreground": "#d19a66", "fontStyle": "strikethrough" } },
    { "scope": ["markup.heading", "markup.heading entity.name"], "settings": { "foreground": "#e06c75", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#56b6c2", "fontStyle": "underline" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#98c379" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#e06c75" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#61afef" } }
  ]
}
